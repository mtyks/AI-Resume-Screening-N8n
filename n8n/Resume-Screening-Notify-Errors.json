    "8.2 Get Problem Candidates": {
      "main": [
        [
          {
            "node": "8.3 Get HR and Admin Emails",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "8.3 Get HR and Admin Emails": {
      "main": [
        [
          {
            "node": "8.4 Build Email",
